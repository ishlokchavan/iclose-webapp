# ── Supabase ──────────────────────────────────────────────
# Non-secret: safe to commit the URL. Keys are NOT — fill locally / in Vercel only.
NEXT_PUBLIC_SUPABASE_URL= #url
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # Supabase → Project Settings → API → anon/public key

# SERVER-ONLY. Never expose to the browser, never commit. (Blueprint §39.2)
SUPABASE_SERVICE_ROLE_KEY=              # Supabase → Project Settings → API → service_role key

# ── Email (transactional) — Resend or Postmark ────────────
EMAIL_API_KEY=
EMAIL_FROM=hello@iclose.ae

# ── Analytics / monitoring (optional for first run) ───────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
SENTRY_DSN=

# ── Bot protection (optional for first run) ───────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
