# ── Supabase ──────────────────────────────────────────────
# Non-secret: safe to commit the URL. Keys are NOT — fill locally / in Vercel only.
NEXT_PUBLIC_SUPABASE_URL= #url
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # Supabase → Project Settings → API → anon/public key

# SERVER-ONLY. Never expose to the browser, never commit. (Blueprint §39.2)
SUPABASE_SERVICE_ROLE_KEY=              # Supabase → Project Settings → API → service_role key

# Public site URL — used to build invite/confirm links in emails.
# Falls back to the request host if unset; set explicitly in Vercel for correctness.
NEXT_PUBLIC_SITE_URL=https://iclose.ae

# ── Email (transactional) — Brevo SMTP ────────────────────
# Brevo → Settings → SMTP & API → SMTP tab
BREVO_SMTP_USER=          # your Brevo SMTP login (e.g. your account email / 8-digit login)
BREVO_SMTP_KEY=           # the SMTP key (master password) from the SMTP tab
# Must be a verified sender in your Brevo account (Senders, Domains & IPs → Senders)
BREVO_FROM=hello@iclose.ae
# Internal inbox that receives new-lead notifications (can be the same as BREVO_FROM)
BREVO_ADMIN_EMAIL=ishlokchavan@gmail.com

# ── Analytics / monitoring (optional for first run) ───────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
SENTRY_DSN=

# ── Bot protection (optional for first run) ───────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
